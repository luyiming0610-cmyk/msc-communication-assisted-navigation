# Formal ROS 2 bag recordings are versioned through Git LFS; see
# .gitattributes and docs/RAW_ROSBAG_INVENTORY.csv. Do not add a generic
# *.db3 ignore rule because it would silently hide future formal evidence.

# ROS/Webots run logs: regenerable diagnostic output, excluded per project policy.
*.log

# Python bytecode cache.
__pycache__/
*.pyc

# ROS 2 colcon build artifacts (not present in this Windows copy today, guarded
# in case a future colcon build is ever run against this tree directly).
/build/
/install/
/log/

# OS/editor noise.
.DS_Store
Thumbs.db

# physical_single_device_zero_impairment_baseline_v1: batch-level Pi raw
# system-metrics CSV, preserved on disk (Pi source + WSL native copy +
# this Windows copy, three-way SHA-256 verified), never committed --
# derived per-trial slices (pi_system_metrics_window.csv) and
# batch_summary.csv/md remain version-controlled as normal.
/experiments/06_physical_pipuck/single_device_bringup/physical_single_device_zero_impairment_baseline_v1_batch/pi_system_metrics_batch_raw.csv

# Formal A-G and shared-exit bags are intentionally tracked through Git LFS.
# Pilot and diagnostic outputs remain excluded by their specific rules below.

# Synthetic/exclusionary assessor-demo analyses exercise exclusion and
# source-identity checks. They are not formal Condition B trials and are not
# part of the dissertation evidence set.
/experiments/05_objective5_impairment_matrix/objective5_matrix_v1_conditionB_exclusionary_assessor_demo_*_analysis/

# First ground diagnostic: per-session runtime confirmations (operator
# present, Wi-Fi checked), timestamped and re-confirmed every session --
# must never be committed as a permanent fact. Managed by
# hil_ground_diagnostic_session.py; see FIELD_MEASUREMENT_FORM.md.
/experiments/07_reality_gap/hil_single_real_shared_exit_20260723/tools/ground_diagnostic_session_state.json

# HIL reality-gap study: raw per-diagnostic evidence (CSV/JSON/JSONL/
# SHA256SUMS alongside the already-ignored *.log files above),
# preserved on disk, never committed, per the same raw-evidence policy
# as the objective5/cooperative-exit bags/ entries above. Listed
# individually (not a wildcard) so a future raw_logs/ directory
# containing anything other than known raw-evidence file types is NOT
# silently ignored -- run_ground_diagnostic_preflight.sh's SOURCE_IDENTITY
# check relies on exactly this: git status only omits paths an ignore
# rule actually names, so any untracked code/config file anywhere
# under this study still shows up as dirty and blocks.
/experiments/07_reality_gap/hil_single_real_shared_exit_20260723/bridge_instrumentation_substitution_20260723/raw_logs/
/experiments/07_reality_gap/hil_single_real_shared_exit_20260723/command_evidence_activation_20260724/raw_logs/
/experiments/07_reality_gap/hil_single_real_shared_exit_20260723/command_evidence_activation_pass_20260724/raw_logs/
/experiments/07_reality_gap/hil_single_real_shared_exit_20260723/stationary_physical_diagnostic_20260723/raw_logs/
/experiments/07_reality_gap/hil_single_real_shared_exit_20260723/stationary_physical_diagnostic_20260723_attempt02/raw_logs/
/experiments/07_reality_gap/hil_single_real_shared_exit_20260723/targeted_stationary_diagnostic_20260723/raw_logs/

# The sealed Stage 4 formal evidence includes the final component logs. These
# negations override the generic *.log rule above only for this one run.
!/experiments/07_reality_gap/hil_single_real_shared_exit_20260723/formal_evidence/
!/experiments/07_reality_gap/hil_single_real_shared_exit_20260723/formal_evidence/stage4_20260803_144220/
!/experiments/07_reality_gap/hil_single_real_shared_exit_20260723/formal_evidence/stage4_20260803_144220/*.log
