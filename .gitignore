# ROS 2 bag recordings: binary, large (hundreds of MB), preserved on disk
# under experiments/*/bags/ per project policy, never committed to git.
*.db3

# ROS/Webots run logs: regenerable diagnostic output, excluded per project policy.
*.log

# Python bytecode cache.
__pycache__/
*.pyc

# ROS 2 colcon build artifacts (not present in this Windows copy today, guarded
# in case a future colcon build is ever run against this tree directly).
/build/
/install/
/log/

# Claude Code runtime lock/session state — not project source.
.claude/*.lock

# OS/editor noise.
.DS_Store
Thumbs.db

# physical_single_device_zero_impairment_baseline_v1: batch-level Pi raw
# system-metrics CSV, preserved on disk (Pi source + WSL native copy +
# this Windows copy, three-way SHA-256 verified), never committed --
# derived per-trial slices (pi_system_metrics_window.csv) and
# batch_summary.csv/md remain version-controlled as normal.
/experiments/06_physical_pipuck/single_device_bringup/physical_single_device_zero_impairment_baseline_v1_batch/pi_system_metrics_batch_raw.csv

# Objective5 impairment matrix: raw formal-trial bags + diag logs (CSVs,
# .log, per-run JSON), preserved on disk (native WSL source + this
# Windows copy, SHA-256 verified both directions), never committed --
# derived evidence (final_verdict.json, summary.md, runtime_manifest.json,
# README.md, SHA256SUMS, matrix_analysis.json, trial_verdict.json,
# frozen_params.json) remains version-controlled as normal in the
# sibling *_analysis/ directory.
/experiments/05_objective5_impairment_matrix/bags/
